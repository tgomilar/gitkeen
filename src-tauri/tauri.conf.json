{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Gitalia",
  "version": "0.1.0",
  "identifier": "app.gitalia.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Gitalia",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; font-src 'self' data:"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/gitalia-backend"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A visual Git workspace"
  }
}

{
  "name": "gitalia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A standalone visual Git workspace. Your editor writes code, Gitalia manages your history.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test server/test/",
    "sidecar": "node scripts/build-sidecar.mjs",
    "desktop:dev": "npm run sidecar && tauri dev",
    "desktop:build": "npm run sidecar && tauri build"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tauri-apps/cli": "^2.12.0",
    "@types/prismjs": "^1.26.6",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "prismjs": "^1.30.0"
  }
}

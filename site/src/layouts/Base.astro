---
import '../styles/site.css';
import Zoom from '../components/Zoom.astro';
import icon from '../../../brand/icon.svg?raw';
import iconDark from '../../../brand/icon-dark.svg?raw';

interface Props {
  title: string;
  description?: string;
  /** `article` for a docs page, so a shared link is described as one. */
  type?: 'website' | 'article';
  /** Keeps a page such as the 404 out of search results. */
  noindex?: boolean;
  /** Structured data for search engines, one schema.org object each. */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description = 'Gitkeen is a visual Git client that works next to any editor. Your editor writes code. Gitkeen manages your commits, history and more.',
  type = 'website',
  noindex = false,
  schema = [],
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// The header mark redraws its lanes under the mouse. While it draws,
// motion-icon fades every fill with the lanes; the tile keeps its own, so only
// the lanes and their dots come back in.
const steadyTile = (svg: string) => svg.replace('<rect ', '<rect fill-opacity="1" ');
const path = Astro.url.pathname;
const inDocs = path.startsWith(`${base}/docs`);
const socialImage = new URL(`${base}/brand/social-preview.png`, Astro.site).href;
const canonical = new URL(path, Astro.site).href;
const socialAlt = 'Gitkeen: a visual Git client that works next to any editor, beside its window with a commit graph and branches';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="google-site-verification" content="TWTDG5sHkQOekIFUa5uWVmi7yO3pJTU7AGMaIPajIHc" />
    {noindex && <meta name="robots" content="noindex" />}
    <!--
      The .ico is for older browsers and for search results, which want a
      bitmap of at least 48 px; it is marked 32x32 so that browsers that can
      draw the SVG still prefer it. The SVG follows the system's light or dark
      mode. Rendered by `npm run favicons`.
    -->
    <link rel="icon" href={`${base}/favicon.ico`} sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={`${base}/brand/icon.svg`} />
    <link rel="icon" type="image/svg+xml" href={`${base}/brand/icon-dark.svg`} media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <meta name="theme-color" content="#fffaf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c1c1f" media="(prefers-color-scheme: dark)" />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="Gitkeen" />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content={socialAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialAlt} />
    {schema.map((item) => <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...item })} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;600&display=swap"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href={`${base}/`} aria-label="Gitkeen home">
          <motion-icon class="mark light" icon={steadyTile(icon)} animation="draw" trigger="hover"></motion-icon>
          <motion-icon class="mark dark" icon={steadyTile(iconDark)} animation="draw" trigger="hover"></motion-icon>
          <picture>
            <source media="(prefers-color-scheme: dark)" srcset={`${base}/brand/wordmark-dark.svg`} />
            <img src={`${base}/brand/wordmark.svg`} alt="Gitkeen" width="103" height="30" />
          </picture>
        </a>
        <nav class="site-nav" aria-label="Main">
          <a href={`${base}/#features`}>Features</a>
          <a href={`${base}/#tour`}>Tour</a>
          <a href={`${base}/docs/`} aria-current={inDocs ? 'page' : undefined}>Docs</a>
          <a href="https://github.com/tgomilar/gitkeen">GitHub</a>
          <a class="btn btn-small" href={`${base}/#download`}>Download</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-row">
        <picture>
          <source media="(prefers-color-scheme: dark)" srcset={`${base}/brand/icon-dark.svg`} />
          <img src={`${base}/brand/icon.svg`} alt="" width="28" height="28" />
        </picture>
        <p>
          Gitkeen is open source under the
          <a href="https://github.com/tgomilar/gitkeen/blob/main/LICENSE">MIT licence</a>.
          This site is built from the
          <a href="https://github.com/tgomilar/gitkeen">repository on GitHub</a>.
        </p>
      </div>
    </footer>
    <Zoom />
    <script>
      import 'motion-components/motion-icon';
    </script>
  </body>
</html>

---
import Docs from '../../layouts/Docs.astro';
import { docsNav } from '../../lib/docs-nav';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Docs
  title="Documentation"
  description="Everything Gitkeen can do, page by page: installing it, committing, changing history, branches and conflicts, undo, the console, and AI help."
>
  <h1>Gitkeen documentation</h1>
  <p>
    Everything Gitkeen can do, page by page. New to Gitkeen? Start with
    <a href={`${base}/docs/install/`}>Installing Gitkeen</a>, then
    <a href={`${base}/docs/getting-started/`}>Getting started</a>.
  </p>
  <table>
    <thead><tr><th scope="col">Page</th><th scope="col">What it covers</th></tr></thead>
    <tbody>
      {
        docsNav.map((p) => (
          <tr>
            <td>
              <motion-hover scale="1" x="4">
                <a href={`${base}/docs/${p.slug}/`}>{p.title}</a>
              </motion-hover>
            </td>
            <td>{p.about}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</Docs>

<script>
  // Each page link nudges right under the mouse. It does nothing when the
  // reader asks for reduced motion.
  import 'motion-components/motion-hover';
</script>

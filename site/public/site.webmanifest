{
  "name": "Gitkeen",
  "short_name": "Gitkeen",
  "description": "A visual Git client that works next to any editor.",
  "start_url": "/gitkeen/",
  "scope": "/gitkeen/",
  "display": "browser",
  "background_color": "#fffaf9",
  "theme_color": "#fffaf9",
  "icons": [
    { "src": "/gitkeen/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/gitkeen/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/gitkeen/brand/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
